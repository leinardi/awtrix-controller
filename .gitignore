# OS files
.DS_Store
Thumbs.db
desktop.ini

# IntelliJ: only the shared code style and copyright profile are tracked
.idea/*
!.idea/codeStyles/
!.idea/copyright/
*.iml

# Other editors
.vscode/
*.code-workspace
*.swp
*~

# Build outputs and profiles
/dist/
/bin/
/build/
*.prof
*.profraw
*.profdata
profile.*

# Tool caches
.cache/

# Claude Code: the shared settings and the skills symlink are tracked; local settings
# (settings.local.json) and session state never are.
.claude/*
!.claude/settings.json
!.claude/skills

# Rust build output
/target/
